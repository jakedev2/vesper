{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.5.1",
  "identifier": "app.vesper.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vesper",
        "width": 1180,
        "height": 740,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0d0e14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Minecraft: Java Edition launcher",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MDAxODQ3MDUyMTI5MTcKUldRWEtTRUZSeGdBR092SVJ5ejNrcjBkc1N5N2JMcEFRNy9FUUlheDh6RjhKK2dhcElmQnhZZnUK",
      "endpoints": [
        "https://github.com/Vesper-CO/vesper/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
